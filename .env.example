# Example configuration for local static checks and unit tests only. Placeholder values; no secrets.
# The application reads process environment variables; it does not load this file automatically.
# In AWS, Terraform sets these on each Lambda function and the AgentCore Runtime.

# Common (all components)
AWS_REGION=us-east-1
CLAIMS_ENVIRONMENT=dev
CLAIMS_APP_NAME=claims-investigator
CLAIMS_LOG_LEVEL=INFO

# Storage and job store
CLAIMS_BUCKET_NAME=claims-investigator-dev-data-example
CLAIMS_JOBS_TABLE_NAME=claims-investigator-dev-jobs

# Upload / intake policy
CLAIMS_MAX_UPLOAD_BYTES=10485760
CLAIMS_ALLOWED_CONTENT_TYPES=text/plain,text/csv,application/json
CLAIMS_PRESIGN_EXPIRY_SECONDS=300
CLAIMS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/111122223333/claims-investigator-dev-investigations
CLAIMS_JOB_TTL_DAYS=30

# Status
CLAIMS_REPORT_URL_EXPIRY_SECONDS=300

# Orchestrator
CLAIMS_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:111122223333:runtime/claims_investigator_dev-EXAMPLE
CLAIMS_AGENT_RUNTIME_QUALIFIER=DEFAULT
CLAIMS_MAX_RECEIVE_COUNT=3
CLAIMS_DISPATCH_LEASE_SECONDS=120
CLAIMS_INVOKE_TIMEOUT_SECONDS=20
CLAIMS_INVESTIGATION_TIMEOUT_SECONDS=1800

# Gateway tools (retrieval)
CLAIMS_OPENSEARCH_ENDPOINT=https://example-collection-id.us-east-1.aoss.amazonaws.com
CLAIMS_OPENSEARCH_INDEX=claims-guidance
CLAIMS_EMBEDDING_MODEL_ID=example-embedding-model-id
CLAIMS_EMBEDDING_DIMENSIONS=1024
CLAIMS_RETRIEVAL_TOP_K=5

# AgentCore Runtime agent
CLAIMS_MODEL_ID=example-model-or-inference-profile-id
CLAIMS_GUARDRAIL_ID=example-guardrail-id
CLAIMS_GUARDRAIL_VERSION=1
CLAIMS_MEMORY_ID=example-memory-id
CLAIMS_GATEWAY_URL=https://example-gateway-id.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
CLAIMS_REVIEW_CONFIDENCE_THRESHOLD=0.7
CLAIMS_MODEL_TIMEOUT_SECONDS=120
CLAIMS_MAX_OUTPUT_RETRIES=1
CLAIMS_MAX_DOCUMENT_BYTES=1048576
CLAIMS_TOOL_TIMEOUT_SECONDS=30
